<%# HTML correspondiente a la navbar-desktop %>

<nav class="navbar-desktop">
  <div class="nav-left">
    <span>Dashboard</span>
    <div>
      <%= link_to 'Gestionar cuentas', accounts_path, class: 'btn' %>
      <%= link_to 'Nuevo movimiento', new_movement_path, class: 'btn' %>
      <%= link_to 'Ver movimientos', movements_path, class: 'btn' %>
    </div>
  </div>
  <div class="nav-right">
    <% if logged_in? %>
      <%= link_to "Dashboard", root_path %> |
      <% if admin? %>
        <%= link_to "Panel de Admin", admin_users_path %> |
      <% end %>
      <%= link_to "Cerrar sesión", logout_path, data: { turbo_method: :delete } %>
    <% else %>
      <%= link_to "Iniciar sesión", login_path %>
    <% end %>
  </div>
</nav>